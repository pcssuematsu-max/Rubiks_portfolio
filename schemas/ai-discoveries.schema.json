{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcssuematsu-max.github.io/Rubiks_portfolio/schemas/ai-discoveries.schema.json",
  "title": "Twisty Puzzle AI discovery feed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "discoveries"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "updatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "discoveries": {
      "type": "array",
      "items": {"$ref": "#/$defs/discovery"}
    }
  },
  "$defs": {
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "puzzle", "setup", "moves", "moveCount", "foundAt", "updatedAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "puzzle": {"type": "string", "minLength": 1},
        "setup": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "moves": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "moveCount": {"type": "integer", "minimum": 1},
        "foundAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
